{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.mjs"],
            "timeout": 60,
            "statusMessage": "Prettier + ESLint"
          }
        ]
      }
    ]
  }
}
